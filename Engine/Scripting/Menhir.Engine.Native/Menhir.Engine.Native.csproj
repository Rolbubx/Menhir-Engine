<Project Sdk="Microsoft.NET.Sdk">

  <!-- The scripting API compiled against Menhir.CoreLib, for IL2C: the engine calls are internal calls into the player. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Menhir.Engine</AssemblyName>
    <RootNamespace>MenhirEngine</RootNamespace>
    <DefineConstants>$(DefineConstants);MENHIR_NATIVE</DefineConstants>
    <NoStdLib>true</NoStdLib>
    <NoCompilerStandardLib>true</NoCompilerStandardLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <RuntimeMetadataVersion>v4.0.30319</RuntimeMetadataVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Source/**/*.cs" />
    <ProjectReference Include="../../../Translator/CoreLib/Menhir.CoreLib.csproj" />
  </ItemGroup>

</Project>
