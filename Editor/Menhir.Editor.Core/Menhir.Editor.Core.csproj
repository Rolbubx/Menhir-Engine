<Project Sdk="Microsoft.NET.Sdk">

  <!-- Editor logic with no UI, windowing or GPU dependency, so it can be unit tested. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Menhir.Editor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The scripting API: the editor hosts scripts in Play mode. -->
    <ProjectReference Include="..\..\Engine\Scripting\Menhir.Engine\Menhir.Engine.csproj" />
  </ItemGroup>

</Project>
