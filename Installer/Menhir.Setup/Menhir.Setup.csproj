<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MenhirSetup: installs Menhir (the editor, the engine's sources, the sample) from the Menhir.zip next to it,
    and uninstalls it (the copy installed as Uninstall.exe). A console wizard; see Installer/README.md.
    Published self-contained, as one trimmed file, by Installer/package.sh.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MenhirSetup</AssemblyName>
    <RootNamespace>Menhir.Setup</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.1.0</Version>
    <!-- LibraryImport (WindowsIntegration) generates unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
