<Project Sdk="Microsoft.NET.Sdk">

  <!-- Editor logic with no UI, windowing or GPU dependency, so it can be unit tested. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Menhir.Editor</RootNamespace>
    <!-- Play mode runs the C scripts' structs and callbacks (Scripting/ScriptLibrary.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
