<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The scripting API games use (Script, Transform, Vector3, Input...), for .NET: the editor runs
    scripts with it in Play mode. Menhir.Engine.Native.csproj compiles the same sources against
    Menhir.CoreLib for the built game (IL2C).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Menhir.Engine</AssemblyName>
    <RootNamespace>MenhirEngine</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Source/**/*.cs" />
  </ItemGroup>

</Project>
